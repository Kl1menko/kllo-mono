# Конфіг для заливки медіа на CDN-хостинг.
# Скопіюй цей файл у scripts/cdn.env і впиши свої дані.
# scripts/cdn.env у .gitignore — креди не потрапляють у репо.

# --- Заливка через PHP-ендпоінт (upload-static.php) ---
# Папка cdn/ роздається через окремий субдомен cdn.kllo.com.ua
# Повний URL ендпоінта на сервері
UPLOAD_ENDPOINT=https://cdn.kllo.com.ua/api/upload-static.php
# API-ключ (заголовок X-API-Key) — має збігатися з ключем у upload-static.php
# ⚠️ Встав свій секретний ключ. НЕ комітити справжній ключ у репо!
UPLOAD_API_KEY=PUT_YOUR_SECRET_KEY_HERE

# Публічний базовий URL, з якого роздається cdn (БЕЗ кінцевого слешу)
PUBLIC_CDN_BASE=https://cdn.kllo.com.ua
